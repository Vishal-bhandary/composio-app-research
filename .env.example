# ─── Stage 3: documentation research (pick ONE) ──────────────────────────────
# Neither key is needed to reproduce the published results. `python3 agent/run.py`
# runs the catalog probe, both verification loops, the audit and the page render
# with no credentials at all.

# Anthropic — https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=

# Gemini — https://aistudio.google.com/apikey  (GOOGLE_API_KEY also works)
GEMINI_API_KEY=

# ─── Stage 2b: authenticated Composio catalog check (optional) ───────────────
# Re-checks the catalog through Composio's REST v3.1 API instead of its public
# pages. https://platform.composio.dev -> Settings -> API Keys
COMPOSIO_API_KEY=
