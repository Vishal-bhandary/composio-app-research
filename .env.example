# Only stage 3 (agent/research.py) needs this. The catalog probe, the
# verification loops, the clustering and the page render all run without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Enables agent/composio_api.py, which re-checks the catalog through
# Composio's authenticated REST v3.1 API instead of its public pages.
# Get one at https://platform.composio.dev -> Settings -> API Keys
COMPOSIO_API_KEY=
